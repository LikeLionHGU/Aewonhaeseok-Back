# 접속 정보 예시. 이 파일을 복사해 .env로 만들고 값을 채운다.
# .env는 .gitignore에 있어 커밋되지 않는다. 실제 비밀번호는 절대 커밋하지 말 것.
#
# IntelliJ에서 실행할 때는 파일 대신 실행 구성에 넣는 편이 편하다.
#   Run > Edit Configurations > BackendApplication > Environment variables

DB_HOST=localhost
DB_PORT=3306
DB_NAME=awon
DB_USER=root
DB_PASSWORD=

# Python 매핑 서비스. 아직 만들지 않았으므로 매핑 실행은 실패한다(정상).
MAPPER_BASE_URL=http://localhost:8000

SERVER_PORT=8080
